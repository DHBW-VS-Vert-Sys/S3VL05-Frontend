{
  "name": "S3VL05-Frontend",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {
      "iptablesSwitchAtRuntime": false
    },
    "ghcr.io/devcontainers/features/python:1": {}
  },
  "customizations": {
    "vscode": {
      "settings": {
        "github.copilot.enable": {
          "*": false
        }
      }
    }
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "nginx",
      "onAutoForward": "notify"
    }
  },
  "postStartCommand": "bash .devcontainer/fix-docker-forward.sh"
}